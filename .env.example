# Copy to your private environment; no production credentials are supplied.
BA_STORAGE_BACKEND=postgres
BA091_AUTH_MODE=secure
BA091_LLM_ACCESS=disabled
BA_LLM_DISABLED=1
LLM_MODEL=deepseek-chat
# LLM_API_KEY and BA091_TOTP_MASTER_KEY_FILE must be set locally.
# PG credentials are read from ~/.banking-agent/pg17/pgpass.conf.
