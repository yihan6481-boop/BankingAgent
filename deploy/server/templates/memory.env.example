HF_HOME=/state/huggingface
HF_HUB_DOWNLOAD_TIMEOUT=600
HF_HUB_OFFLINE=1
HF_HUB_VERBOSITY=error
HINDSIGHT_API_DATABASE_URL=postgresql://r4_hindsight_native:<EXISTING_URL_ENCODED_PASSWORD>@database:5432/r4_memory_server_main
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=true
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=/models/embeddings
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
HINDSIGHT_API_HOST=0.0.0.0
HINDSIGHT_API_LLM_API_KEY=<EXISTING_GATEWAY_TOKEN>
HINDSIGHT_API_LLM_BASE_URL=http://gateway:18761/v1
HINDSIGHT_API_LLM_EXTRA_BODY={"thinking":{"type":"enabled"}}
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_LLM_MAX_RETRIES=0
HINDSIGHT_API_LLM_MODEL=deepseek-flash
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_REASONING_EFFORT=high
HINDSIGHT_API_LOG_LEVEL=warning
HINDSIGHT_API_PORT=18889
HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=8192
HINDSIGHT_API_RERANKER_LOCAL_MODEL=/models/reranker
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=8192
HINDSIGHT_API_SKIP_LLM_VERIFICATION=true
HINDSIGHT_API_TENANT_API_KEY=<EXISTING_MEMORY_TENANT_TOKEN>
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=0
HINDSIGHT_API_WORKER_ID=banking-server-memory
HINDSIGHT_API_WORKER_MAX_CONCURRENT_OPERATIONS=1
HINDSIGHT_API_WORKER_MAX_RETRIES=0
HINDSIGHT_API_WORKER_MAX_SLOTS=1
HINDSIGHT_CP_DATAPLANE_API_URL=http://memory:18889
HINDSIGHT_ENABLE_API=true
HINDSIGHT_ENABLE_CP=false
