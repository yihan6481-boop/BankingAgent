# Copy existing approved credentials; do not mint a new ledger or enlarge limits.
LLM_API_KEY=<EXISTING_PROVIDER_KEY>
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
VISION_API_KEY=<EXISTING_VISION_KEY>
VISION_MODEL=deepseek-flash
VISION_BASE_URL=https://api.deepseek.com
R4_PROVIDER_KEY=<EXISTING_PROVIDER_KEY>
R4_TARGET_MODEL=deepseek-flash
R4_GATEWAY_TOKEN=<EXISTING_GATEWAY_TOKEN>
R4_PROVIDER_BASE_URL=https://api.deepseek.com

# Optional audio transcription: disabled until a real compatible provider is configured.
# Add these values to files.model_environment in the existing private server config.
# Chat/vision credentials do not imply audio transcription support.
BA_ASR_ENABLED=0
BA_ASR_ENDPOINT=https://api.siliconflow.cn/v1/audio/transcriptions
BA_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
BA_ASR_API_KEY=
BA_ASR_MIME_TYPES=audio/webm,audio/mp4,audio/ogg,audio/wav,audio/mpeg
